{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pmcro:plugin:v1",
  "title": "PMCR-O plugin artifact manifest",
  "type": "object",
  "required": [
    "schema", "artifactId", "artifactType", "version", "parent", "owner", "template",
    "sourceMarketplaces", "children", "requiredShape", "entrypoint", "routes",
    "contracts", "governance", "execution", "evidence", "promotion", "nextSeed"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "pmcro.plugin.v1" },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactType": { "const": "plugin" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "parent": {
      "type": "object",
      "required": ["artifactId", "runId", "depth", "maxDepth"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "idKind": { "enum": ["native", "derived"] },
        "depth": { "type": "integer", "minimum": 0 },
        "maxDepth": { "type": "integer", "minimum": 1 }
      }
    },
    "owner": {
      "type": "object",
      "required": ["principal", "domainId", "charterId"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "domainId": { "type": "string", "minLength": 1 },
        "charterId": { "type": "string", "minLength": 1 }
      }
    },
    "template": { "type": "object" },
    "sourceMarketplaces": { "type": "array" },
    "children": { "type": "array" },
    "requiredShape": { "type": "object" },
    "entrypoint": {
      "type": "object",
      "required": ["assembly", "type"],
      "properties": {
        "assembly": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "operation", "target", "policyRef", "permissions"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "operation": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^@" },
          "policyRef": { "type": "string", "minLength": 1 },
          "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "contracts": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "dependencies": { "type": "array" },
    "governance": {
      "type": "object",
      "required": ["enabledByDefault", "approvalRequired", "trailRequired", "policyRef"],
      "properties": {
        "enabledByDefault": { "const": false },
        "approvalRequired": { "const": true },
        "trailRequired": { "const": true },
        "policyRef": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "required": ["maxDepth", "retryLimit", "idempotencyRequired"],
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 1 },
        "retryLimit": { "type": "integer", "minimum": 0 },
        "idempotencyRequired": { "const": true }
      }
    },
    "training": { "type": "object" },
    "evidence": { "type": "object", "required": ["tier", "verificationRefs"] },
    "promotion": { "enum": ["described", "composed", "generated", "validated", "checked", "staged", "promoted", "rejected"] },
    "nextSeed": { "type": "object" }
  },
  "additionalProperties": false
}
