{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMCR-O Command Envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "commandId",
    "intentId",
    "runId",
    "correlationId",
    "actorId",
    "commandType",
    "issuedAt",
    "idempotencyKey",
    "payload",
    "context"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "intentId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "commandType": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "context": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
