{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.dev/schemas/execution-policy.schema.json",
  "title": "PMCR-O Execution Policy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "capabilityId", "timeoutSeconds", "maxAttempts", "initialBackoffMilliseconds", "maxBackoffSeconds", "maxEvidenceLength", "requireReconciliationForUnknownNonIdempotentOutcome", "allowAutomaticRetryForIdempotentOperations", "redactFieldNames"],
  "properties": {
    "policyId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
    "initialBackoffMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "maxBackoffSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "maxEvidenceLength": { "type": "integer", "minimum": 32, "maximum": 16384 },
    "requireReconciliationForUnknownNonIdempotentOutcome": { "type": "boolean", "const": true },
    "allowAutomaticRetryForIdempotentOperations": { "type": "boolean" },
    "redactFieldNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
